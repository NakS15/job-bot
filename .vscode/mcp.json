{
  "servers": {
    "linkedin": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/uvx",
      "args": ["mcp-server-linkedin@latest", "--no-headless", "--log-level", "INFO"],
      "env": { "UV_HTTP_TIMEOUT": "300" }
    },
    "job-agent": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/job-agent",
      "args": ["serve"],
      "env": { "JOB_AGENT_HOME": "${userHome}/.job-agent" }
    }
  }
}
